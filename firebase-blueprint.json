{
  "entities": {
    "NewsPost": {
      "title": "NewsPost",
      "description": "Enterprise secure digital publications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "author": { "type": "string" }
      },
      "required": ["id", "title", "content", "category", "createdAt", "author"]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Print shop service divisions details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "shortDesc": { "type": "string" },
        "longDesc": { "type": "string" },
        "image": { "type": "string" },
        "iconName": { "type": "string" },
        "bullets": { "type": "array" }
      },
      "required": ["id", "title", "shortDesc", "longDesc", "image"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "High-contrast visual industrial assets.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "title", "category", "image"]
    },
    "JobVacancy": {
      "title": "JobVacancy",
      "description": "Talent acquisition roles available at the press.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "department": { "type": "string" },
        "type": { "type": "string" },
        "salary": { "type": "string" },
        "deadline": { "type": "string" },
        "requirements": { "type": "array" },
        "benefits": { "type": "array" }
      },
      "required": ["id", "title", "department", "type", "salary", "deadline"]
    },
    "SettingsConfig": {
      "title": "SettingsConfig",
      "description": "General text configurations, company data and visual slides.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyInfo": { "type": "object" },
        "slides": { "type": "array" },
        "statistics": { "type": "array" }
      },
      "required": ["id", "companyInfo", "slides", "statistics"]
    },
    "CMSUser": {
      "title": "CMSUser",
      "description": "CMS system user account with role-based access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "editor", "author", "viewer"] },
        "status": { "type": "string", "enum": ["active", "locked"] },
        "twoFactorEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "status", "createdAt"]
    },
    "CMSAuditLog": {
      "title": "CMSAuditLog",
      "description": "Audit security log of user actions in the CMS.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "timestamp", "userId", "userEmail", "action"]
    }
  },
  "firestore": {
    "/news/{newsId}": {
      "schema": "NewsPost",
      "description": "Publications for the company activities feed."
    },
    "/services/{serviceId}": {
      "schema": "ServiceItem",
      "description": "Services offered by the print shop."
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Filtering items for the images gallery grid."
    },
    "/vacancies/{vacancyId}": {
      "schema": "JobVacancy",
      "description": "Recruitment postings."
    },
    "/settings/{settingId}": {
      "schema": "SettingsConfig",
      "description": "Dynamic layout texts, slides and contacts."
    },
    "/cms_users/{userId}": {
      "schema": "CMSUser",
      "description": "CMS user account records."
    },
    "/cms_audit_logs/{logId}": {
      "schema": "CMSAuditLog",
      "description": "Audit activity tracking records."
    }
  }
}
