rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for zero-trust authorization
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() && 
             request.auth.token.email == "xnitchcm@gmail.com" &&
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. News Publications rules
    match /news/{newsId} {
      allow read: if true;
      allow create, delete: if isVerifiedAdmin() && isValidId(newsId);
      allow update: if isVerifiedAdmin() && isValidId(newsId);
    }

    // 2. Service divisions rules
    match /services/{serviceId} {
      allow read: if true;
      allow create, delete: if isVerifiedAdmin() && isValidId(serviceId);
      allow update: if isVerifiedAdmin() && isValidId(serviceId);
    }

    // 3. Gallery assets rules
    match /gallery/{galleryId} {
      allow read: if true;
      allow create, delete: if isVerifiedAdmin() && isValidId(galleryId);
      allow update: if isVerifiedAdmin() && isValidId(galleryId);
    }

    // 4. Job recruitment listings
    match /vacancies/{vacancyId} {
      allow read: if true;
      allow create, delete: if isVerifiedAdmin() && isValidId(vacancyId);
      allow update: if isVerifiedAdmin() && isValidId(vacancyId);
    }

    // 5. Layout and settings configurator documents
    match /settings/{settingId} {
      allow read: if true;
      allow create, delete: if isVerifiedAdmin() && isValidId(settingId);
      allow update: if isVerifiedAdmin() && isValidId(settingId);
    }
  }
}
